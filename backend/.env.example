# ==============================================================================
# Backend Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rbac_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rbac_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000
DB_SSL=false

# Security & Secrets
# Required: 64-character hex string or strong random secret for signed cookies & sessions
SESSION_SECRET=change_me_to_a_secure_random_64_char_hex_key_for_sessions
COOKIE_SECRET=change_me_to_a_secure_random_64_char_hex_key_for_cookies

# Encryption & HMAC Keys (AES-256 / SHA-256 HMAC for sensitive values & audit validation)
RBAC_ENCRYPTION_KEY=change_me_to_a_secure_32_byte_hex_key_for_aes_encryption
RBAC_AUDIT_HMAC_KEY=change_me_to_a_secure_32_byte_hex_key_for_audit_hmac

# File Storage
UPLOADS_ROOT=./uploads

# Rate Limiting Configuration
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_STRICT_MAX=20
RATE_LIMIT_STRICT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW_MS=60000

# Concurrency & Session Limits
MAX_CONCURRENT_SESSIONS_PER_USER=100
